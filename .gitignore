# Secrets — never committed. See .secret.example for the shape.
.secret
.env.local
docker-compose.override.yml

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Run output. `evidence/` is a graded deliverable (brief S6), so the runs that
# demonstrate the flow are committed by exception with `git add -f`; this line
# stops every scratch run from following them in.
evidence/runs/
# Approved artifacts are NOT committed. Approval is a person's act on a
# machine; committing one would let the next clone replay unattended on a
# review nobody in that clone performed, which is the gate being decoration.
# Drafts ARE committed -- they are the reviewable deliverable (brief S6), they
# are deterministic (`interfaceai capability export`), and a test compares them
# byte for byte against the authored source.
artifacts/*.approved.json

# Control maps written by discovery. NOT ignored: measured at 344 KB for the two
# ParaBank screens, which is small enough that committing them lets a reviewer
# replay without paying for a discovery run. Revisit if a real deployment's maps
# grow -- the templates would move to blob storage and the store's interface
# would not change.
.playwright/
*.log

# macOS
.DS_Store
