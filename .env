# Committed config (NO SECRETS — those go in .secret, which is gitignored).
# Convention borrowed from nobsmed-v2: .env = config, .secret = credentials.

# Names the compose project (containers, network). Set here rather than with a
# top-level `name:` in docker-compose.yml, which compose < 2.3 rejects.
COMPOSE_PROJECT_NAME=interfaceai

# --- ParaBank: the local "legacy bank app" we automate against ---
# Tenant A ("baseline" image) — the surface we record capabilities on.
PARABANK_BASE_URL=http://localhost:8080/parabank
PARABANK_PORT=8080
PARABANK_JMS_PORT=61616
PARABANK_DB_PORT=9001

# Tenant B ("feature" image) — same vendor product, different build.
# Stand-in for two institutions running the same core banking package.
# Only running under: docker compose --profile tenant-b up -d
PARABANK_B_BASE_URL=http://localhost:8081/parabank
PARABANK_B_PORT=8081
PARABANK_B_JMS_PORT=61617
PARABANK_B_DB_PORT=9002

# --- Vision model for control mapping ---
# Azure OpenAI, same deployment nobsmed-v2 uses for gpt-4.1. Endpoint and
# api-version are not secrets; the key lives in .secret as VISION_API_KEY.
# Profile name from mapper.PROFILES: gpt-4.1 | gpt-4o | gpt-5.2-chat | claude-opus
VISION_PROFILE=gpt-4.1

# --- Safety guardrails (assignment 3.4) ---
# The agent may only act against these origins. Comma-separated.
INTERFACEAI_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# --- Demo fixtures (ParaBank seeds these on DB init) ---
PARABANK_DEMO_USERNAME=john

# Value-dependent risk (assignment 3.4), per tenant (3.7).
# A money amount at or above this needs a person, whatever control it is typed
# into. `irreversible` on a control says "this moves money"; this says "this
# amount is one somebody should look at". One institution's routine transfer is
# another's exception, so it is config rather than a constant.
# A tenant not listed has no threshold and falls back to control-level risk.
INTERFACEAI_CONFIRM_MONEY_ABOVE=baseline=1000,feature=250

# Which capabilities a tenant permits (assignment 3.4 + 3.7).
# ⚠️ MAKE-BELIEVE. ParaBank has no roles, so this is OUR gate modelling what a
# real deployment would enforce -- not the application denying an operator.
# Those are different things and docs/failure-modes.md keeps them apart.
# Checked at entry AND at every invoke, so a permitted capability cannot reach
# a forbidden one. `*` permits everything.
# ⛔ AN UNLISTED TENANT IS REFUSED. This line said "unrestricted", which is what
# the code used to do and is the fail-open Copilot found: a typo'd `--tenant`
# got MORE permission than the real name. Only an entirely empty setting turns
# the gate off. Adding a tenant means adding it here.
# ⚠️ `log_in_discovered` was MISSING here, and it is the capability the README's
# cross-tenant demo replays -- so the documented proof of S3.7 failed at
# pre-flight with "not permitted for feature". The exclusion that carries the
# demonstration is `request_loan`: tenant B does not do loans. Excluding the
# demo itself was a fixture bug. Found by Copilot, PR #5.
INTERFACEAI_ALLOWED_CAPABILITIES=baseline=*;feature=log_in,log_in_discovered,read_savings_balance,discovered_balance
