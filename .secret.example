# Copy to .secret (gitignored) and fill in. Never commit .secret.
#
#   cp .secret.example .secret

# Azure OpenAI key for the vision/control-mapping calls. This is the value
# nobsmed-v2 keeps as API_KEY for the openai-rg-nobsmed endpoint:
#   grep '^API_KEY=' ~/workspace/nobsmed-v2/.secret | sed 's/^API_KEY=/VISION_API_KEY=/' >> .secret
VISION_API_KEY=

# Model API access for the discovery run. The assignment requires at least one
# genuine LLM-driven run, so this is not optional for `make discover`.
ANTHROPIC_API_KEY=

# ParaBank demo password. Not a real credential (the app ships with it seeded),
# but it lives here so nothing teaches the codebase that passwords belong in .env.
PARABANK_DEMO_PASSWORD=demo
