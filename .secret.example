# Copy to .secret (gitignored) and fill in ONE value.
#
#   cp .secret.example .secret

# ── Required: a plain OpenAI API key ────────────────────────────────────────
# One key. No endpoint, no Azure resource, no deployment to name.
# Verified end to end on 2026-10-07: discovery, replay, and all 38 live tests.
OPENAI_API_KEY=

# ── ParaBank demo password ──────────────────────────────────────────────────
# Not a real credential -- the app ships with it seeded -- but it lives here so
# nothing teaches the codebase that passwords belong in .env.
PARABANK_DEMO_PASSWORD=demo

# ── Azure instead, if that is what you have ─────────────────────────────────
# Set VISION_PROFILE=gpt-4.1 in .env, plus both of these. Needs a deployment
# named `gpt-4.1`. This is what produced the evidence committed before
# 2026-10-07.
# VISION_API_BASE=https://<your-resource>.openai.azure.com/
# VISION_API_KEY=
# VISION_API_KEY_EASTUS2=     # only for evals/grade.py's second and third graders
