# Copy to .secret (gitignored) and fill in two values.
#
#   cp .secret.example .secret

# ── Required: Azure OpenAI, with a deployment named `gpt-4.1` ────────────────
# The only configuration this project has been run on. Every committed
# artifact and every number in REPORT.md came from it.
VISION_API_BASE=https://<your-resource>.openai.azure.com/
VISION_API_KEY=

# ── ParaBank demo password ──────────────────────────────────────────────────
# Not a real credential -- the app ships with it seeded -- but it lives here so
# nothing teaches the codebase that passwords belong in .env.
PARABANK_DEMO_PASSWORD=demo

# ── Only for evals/grade.py, which asks a second and third model ────────────
# VISION_API_KEY_EASTUS2=

# ── Wired but NOT TESTED. Not the documented path; see README §Config. ──────
# VISION_PROFILE=openai-gpt-4.1
# OPENAI_API_KEY=
# VISION_PROFILE=claude-opus
# ANTHROPIC_API_KEY_FOR_VISION=
