{
  "schema_version": 1,
  "name": "read_savings_balance",
  "version": 2,
  "goal": "read the current balance of a member's savings account",
  "vocabulary_version": 1,
  "target": {
    "app": "parabank",
    "tenant": "baseline",
    "base_url": "http://localhost:8080/parabank"
  },
  "viewport_width": 1280,
  "viewport_height": 900,
  "params": [
    {
      "name": "account_id",
      "slot": "account_id",
      "required": true
    }
  ],
  "returns": [
    {
      "name": "found_account_id",
      "slot": "account_id"
    },
    {
      "name": "balance",
      "slot": "balance"
    }
  ],
  "requires": [
    {
      "name": "at_the_login_page",
      "control": {
        "screen": "index",
        "control_id": "username_textbox",
        "discriminator": null
      },
      "must": "present",
      "why": "This capability establishes its own session, so it must start from the login screen. Re-checked on resume, since a human handed the browser back may have navigated anywhere."
    }
  ],
  "steps": [
    {
      "verb": "enter",
      "control": {
        "screen": "index",
        "control_id": "username_textbox",
        "discriminator": null
      },
      "value": {
        "kind": "secret",
        "input_ref": "parabank_username"
      },
      "slot": "username",
      "output": null,
      "row_key": null,
      "field": null,
      "risky": false,
      "note": "Sensitive slot: the artifact carries the KEY, never the value."
    },
    {
      "verb": "enter",
      "control": {
        "screen": "index",
        "control_id": "password_textbox",
        "discriminator": null
      },
      "value": {
        "kind": "secret",
        "input_ref": "parabank_demo_password"
      },
      "slot": "password",
      "output": null,
      "row_key": null,
      "field": null,
      "risky": false,
      "note": "Same. `use_control` records value_length and never the value."
    },
    {
      "verb": "click",
      "control": {
        "screen": "index",
        "control_id": "log_in_button",
        "discriminator": null
      },
      "value": null,
      "slot": null,
      "output": null,
      "row_key": null,
      "field": null,
      "risky": false,
      "note": "Reversible: logging out undoes it, so not risky."
    },
    {
      "verb": "wait_for",
      "control": {
        "screen": "overview",
        "control_id": "accounts_table_panel",
        "discriminator": null
      },
      "value": null,
      "slot": null,
      "output": null,
      "row_key": null,
      "field": null,
      "risky": false,
      "note": "The table's own header is the anchor -- unique, unlike any of its rows."
    },
    {
      "verb": "observe",
      "control": null,
      "value": null,
      "slot": null,
      "output": null,
      "row_key": null,
      "field": null,
      "risky": false,
      "note": "Evidence frame of the screen the values below are read from (S3.5)."
    },
    {
      "verb": "extract",
      "control": {
        "screen": "overview",
        "control_id": "accounts_table_panel",
        "discriminator": null
      },
      "value": null,
      "slot": "account_id",
      "output": "found_account_id",
      "row_key": {
        "kind": "param",
        "param": "account_id"
      },
      "field": "account_id",
      "risky": false,
      "note": "Read the WHOLE table in one call, then select the row in code. Reading the id back is what lets the checkpoint prove we answered about the account the caller asked for."
    },
    {
      "verb": "extract",
      "control": {
        "screen": "overview",
        "control_id": "accounts_table_panel",
        "discriminator": null
      },
      "value": null,
      "slot": "balance",
      "output": "balance",
      "row_key": {
        "kind": "param",
        "param": "account_id"
      },
      "field": "balance",
      "risky": false,
      "note": "What the caller asked for. Never asserted -- it is the answer."
    }
  ],
  "checkpoints": [
    {
      "output": "found_account_id",
      "op": "equals",
      "expected": {
        "kind": "param",
        "param": "account_id"
      },
      "why": "The row we read must be the row that was asked for. An account that is absent entirely is a business outcome, not this."
    }
  ],
  "approval": "draft",
  "approved_by": null
}
